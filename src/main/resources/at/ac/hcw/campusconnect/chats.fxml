<?xml version="1.0" encoding="UTF-8"?>

<?import at.ac.hcw.campusconnect.components.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane styleClass="chats-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="at.ac.hcw.campusconnect.controller.ChatsController">

    <!-- Error Box -->
    <ErrorBox fx:id="errorBox" StackPane.alignment="TOP_CENTER">
        <StackPane.margin>
            <Insets top="20" />
        </StackPane.margin>
    </ErrorBox>

    <HBox spacing="0" styleClass="chats-content">
        <!-- Chat List -->
        <VBox prefWidth="350" spacing="0" styleClass="chat-list-panel">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="10" />
                </padding>
                <Label styleClass="page-title" text="Messages" />
            </HBox>

            <!-- Chat List -->
            <ScrollPane fitToWidth="true" styleClass="chat-list-scroll" vmax="0.0" VBox.vgrow="ALWAYS">
                <VBox fx:id="chatList" spacing="0" />
            </ScrollPane>
        </VBox>

        <!-- Chat Area -->
        <VBox fx:id="chatArea" spacing="0" styleClass="chat-area" HBox.hgrow="ALWAYS">
            <!-- Chat Header -->
            <HBox fx:id="chatHeader" alignment="CENTER_LEFT" spacing="15" styleClass="chat-header">
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
                <StackPane fx:id="chatAvatar" prefHeight="45" prefWidth="45" styleClass="profile-avatar-small" />
                <VBox spacing="2">
                    <Label fx:id="chatUserName" styleClass="chat-user-name" text="Select a chat" />
                    <Label fx:id="chatUserInfo" styleClass="chat-user-info" text="" />
                </VBox>
            </HBox>

            <Separator />

            <!-- Messages Area -->
            <ScrollPane fx:id="messagesScrollPane" fitToWidth="true" styleClass="messages-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="messagesContainer" spacing="10" styleClass="messages-container">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>
                </VBox>
            </ScrollPane>

            <!-- Message Input -->
            <HBox alignment="CENTER" spacing="10" styleClass="message-input-container">
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
                <TextField fx:id="messageInput" onAction="#handleSendMessage" promptText="Type a message..." styleClass="message-input" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" onAction="#handleSendMessage" styleClass="send-button">
                    <graphic>
                        <SVGPath content="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" styleClass="send-icon" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</StackPane>
